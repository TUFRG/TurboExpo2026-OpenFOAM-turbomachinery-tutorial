FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0.000091; // 5 X molecular viscosity

boundaryField
{
	#includeEtc "caseDicts/setConstraintTypes"
	inlet
	{
        type            freestream;
	freestreamValue	$internalField
        value           $internalField;	          
	}
	Outlet
	{
		type            zeroGradient;		
	}
	wall
	{
       		type            fixedValue;
       		value           uniform 0;
	}
}


