);

edges
(
        arc Mx0y3 Px0y3 $Mx0y3Px0y3
        arc Mx0y4 Px0y4 $Mx0y4Px0y4
        arc Mx2y4 Px2y4 $Mx2y4Px2y4 
        arc Mx2y5 Px2y5 $Mx2y5Px2y5

        arc Mx0y3 Nx0y3 $Mx0y3Nx0y3
        arc Mx0y4 Nx0y4 $Mx0y4Nx0y4
        arc Mx2y4 Nx2y4 $Mx2y4Nx2y4 
        arc Mx2y5 Nx2y5 $Mx2y5Nx2y5

        arc MxSy3 PxSy3 $MxSy3PxSy3
        arc MxSy4 PxSy4 $MxSy4PxSy4
        arc MxSy3 NxSy3 $MxSy3NxSy3
        arc MxSy4 NxSy4 $MxSy4NxSy4

        arc Mx0y2 Px0y2 $Mx0y2Px0y2
        arc Mx0y2 Nx0y2 $Mx0y2Nx0y2
        arc Mx2y3 Px2y3 $Mx2y3Px2y3 
        arc Mx2y3 Nx2y3 $Mx2y3Nx2y3 

        project Mx2y0 Px2y1 (hub pPer)
        project Mx2y0 Nx2y1 (hub nPer)
        project Mx2y1 Px2y1 (hub pVal)
        project Mx2y1 Nx2y1 (hub nVal)
        project Px2y1 Px2y2 (hub pPer)
        project Nx2y1 Nx2y2 (hub nPer)
        project Mx2y1 Mx2y2 (hub mPer)
        project Mx2y2 Px2y2 (hub out)
        project Mx2y2 Nx2y2 (hub out)




);

blocks
(
        //     0    3     7     4     1     2     6     5
    hex (Mx0y3 Mx0y4 Px0y4 Px0y3 MxSy3 MxSy4 PxSy4 PxSy3) ($ptsRTopBL $ptsTheta $ptsZslip) simpleGrading ($gTopBL 1 $gAxSlip) //(0.000575 1 0.457)              // Top BL block slip pos
    hex (Nx0y3 Nx0y4 Mx0y4 Mx0y3 NxSy3 NxSy4 MxSy4 MxSy3) ($ptsRTopBL $ptsTheta $ptsZslip) simpleGrading ($gTopBL 1 $gAxSlip) //(0.000575 1 0.457)              // Top BL block slip neg

    hex (MxSy3 MxSy4 PxSy4 PxSy3 Mx2y4 Mx2y5 Px2y5 Px2y4) ($ptsRTopBL $ptsTheta $ptsZnoSlip) simpleGrading ($gTopBL 1 $gAxNoSlip) //(0.000575 1 0.274)          //Top BL block no-slip pos
    hex (NxSy3 NxSy4 MxSy4 MxSy3 Nx2y4 Nx2y5 Mx2y5 Mx2y4) ($ptsRTopBL $ptsTheta $ptsZnoSlip) simpleGrading ($gTopBL 1 $gAxNoSlip) //(0.000575 1 0.274)          //Top BL block no-slip neg

    hex (Mx0y2 Mx0y3 Px0y3 Px0y2 MxSy2 MxSy3 PxSy3 PxSy2) ($ptsRMid $ptsTheta $ptsZslip) simpleGrading (1 1 $gAxSlip)           // Mid block slip pos
    hex (Nx0y2 Nx0y3 Mx0y3 Mx0y2 NxSy2 NxSy3 MxSy3 MxSy2) ($ptsRMid $ptsTheta $ptsZslip) simpleGrading (1 1 $gAxSlip)           // Mid block slip neg

    hex (MxSy2 MxSy3 PxSy3 PxSy2 Mx2y3 Mx2y4 Px2y4 Px2y3) ($ptsRMid $ptsTheta $ptsZnoSlip) simpleGrading (1 1 $gAxNoSlip)               // Mid block no-slip pos
    hex (NxSy2 NxSy3 MxSy3 MxSy2 Nx2y3 Nx2y4 Mx2y4 Mx2y3) ($ptsRMid $ptsTheta $ptsZnoSlip) simpleGrading (1 1 $gAxNoSlip)               // Mid block no-slip neg

    hex (Mx0y1 Mx0y2 Px0y2 Px0y1 MxSy1 MxSy2 PxSy2 PxSy1) ($ptsRLow $ptsTheta $ptsZslip) simpleGrading ($gRLow 1 $gAxSlip)              // Low block slip pos
    hex (Nx0y1 Nx0y2 Mx0y2 Mx0y1 NxSy1 NxSy2 MxSy2 MxSy1) ($ptsRLow $ptsTheta $ptsZslip) simpleGrading ($gRLow 1 $gAxSlip)              // Low block slip neg

    hex (MxSy1 MxSy2 PxSy2 PxSy1 Mx1y1 Mx2y3 Px2y3 Px1y1) ($ptsRLow $ptsTheta $ptsZnoSlip) simpleGrading ($gRLow 1 $gAxNoSlip)          // Low block no-slip pos
    hex (NxSy1 NxSy2 MxSy2 MxSy1 Nx1y1 Nx2y3 Mx2y3 Mx1y1) ($ptsRLow $ptsTheta $ptsZnoSlip) simpleGrading ($gRLow 1 $gAxNoSlip)          // Low block no-slip ned 

    hex (Mx1y1 Mx2y3 Px2y3 Px1y1 Mx2y1 Mx2y2 Px2y2 Px2y1) ($ptsRLow $ptsTheta $ptsHubBL) simpleGrading ($gRLow 1 $gHubBL)               // Spinner nose block pos
    hex (Nx1y1 Nx2y3 Mx2y3 Mx1y1 Nx2y1 Nx2y2 Mx2y2 Mx2y1) ($ptsRLow $ptsTheta $ptsHubBL) simpleGrading ($gRLow 1 $gHubBL)               // Spinner nose block neg 

    // Hub block slip
    hex (Mx0y0 MxSy0 NxSy1 Nx0y1 Px0y1 PxSy1 MxSy1 Mx0y1) ($ptsZslip $ptsTheta $ptsRHub) 
    edgeGrading 
    (
        $gAxSlip $gAxSlip $gAxSlip $gAxSlip
        $G $G 1 1
        $G $G 1 1
    )
    // Hub block no-slip
    hex (MxSy0 Mx1y0 Nx1y1 NxSy1 PxSy1 Px1y1 Mx1y1 MxSy1) ($ptsZnoSlip $ptsTheta $ptsRHub) //simpleGrading (0.274 1 1)
    edgeGrading 
    (
        $gAxNoSlip $gAxNoSlip $gAxNoSlip $gAxNoSlip 
        $G $G 1 1
        $G $G 1 1
    )

   // Hub block on the spinner nose - butterfly mesh
   hex (Mx1y0 Mx2y0 Nx2y1 Nx1y1 Px1y1 Px2y1 Mx2y1 Mx1y1) ($ptsHubBL  $ptsTheta $ptsRHub) // simpleGrading (0.0008 1 1)
        edgeGrading 
        (
                $gHubBL $gHubBL $gHubBL $gHubBL
                $G $G 1 1
                $G $G 1 1
        )	// Butterfly Mesh


);

