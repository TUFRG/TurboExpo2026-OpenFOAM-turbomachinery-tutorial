FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
	default         steadyState;
}

gradSchemes
{
	default        cellLimited Gauss linear 0; // cellLimited leastSquares 1;
//	 grad(p)         Gauss linear;
	 grad(U)         cellLimited Gauss linear 0.333;
}

divSchemes
{
	default         none;
	div(phi,U)      Gauss upwind; //Gauss limitedLinear 0.8;
	div(phid,p)     Gauss upwind; //Gauss limitedLinear 0.8;  
	div(phiv,p)     Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,K)      Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,Ekp)    Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,e)      Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,h)      Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,k)      Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,epsilon) Gauss upwind; //Gauss limitedLinear 0.8;
	div(phi,omega)   Gauss upwind; //Gauss limitedLinear 0.8;
	div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
	default         Gauss linear limited corrected 1.0;
}

interpolationSchemes
{
	default         linear;
}

snGradSchemes
{
	default         limited corrected 1.0;
}

wallDist
{
	method 	    meshWave;
	nRequired       yes;
}


