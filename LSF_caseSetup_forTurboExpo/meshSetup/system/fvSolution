FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(p|rho)"
    {
        solver          		GAMG;
        smoother			symGaussSeidel;
        tolerance       		1e-08;
        relTol          		0.05;
	nCellsInCoarsestLevel		1000;
    }

    "(p|rho)Final"
    {
        $p;
	tolerance	1e-8;
        relTol		0;
	minIter		1;
    }

    "(U|k|epsilon|omega|e|h)"
    {
        solver		PBiCGStab;
        preconditioner	DILU;
	nSweeps		2;
        tolerance       1e-05;
        relTol          0.05;
	minIter		1;
    }

    "(U|k|epsilon|omega|e|h)Final"
    {
        $e;
        tolerance       1e-05;
        relTol          0;
        minIter         1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 3;
    pMin 35000; //40000; 
    pMax 180000; //180000;
    rhoMax 2.5; 
    rhoMin 0.5; 
    transonic	yes;
    consistent	yes;

    residualControl
    {
        p               	1e-4;
        U               	1e-5;
        "(e|h)"            	1e-4;
        "(k|epsilon|omega)"	1e-4;
    }

}



relaxationFactors
{
    fields
    {
        p               	1;
	rho			0.1;
    }
    equations
    {
        U               	0.9;
        "(k|epsilon|omega)"	0.9;
        "(e|h)"           	0.9;
    }
}


