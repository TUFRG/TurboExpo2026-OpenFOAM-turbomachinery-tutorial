FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // For meshes with
    // disparities in angle span across the mixingPlane interface, a
    // solver for asymmetrical matrices is required, like BiCGStab. When
    // in doubt, just select a solver for asymmetrical matrices for p.
    p
    {
        solver           PBiCGStab;
        preconditioner   FDIC;
        tolerance        1e-08;
        relTol           0.1;
    }
    "(U|k|epsilon|omega|e|h|nuTilda)"
    {
        solver           PBiCGStab;
        preconditioner   DILU;
        tolerance        1e-08;
        relTol           0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;//3; //can try to increase if above 75
    consistent	yes;

    residualControl
    {
        p               	1e-6;
        U               	1e-6;
        "(e|h)"            	1e-6;
        "(k|epsilon|omega|nuTilda)"	1e-6;
    }
}

relaxationFactors
{
    fields
    {
        p               		1;
    }
    equations
    {
        U               		0.9;
        "(k|epsilon|omega|nuTilda)"	0.7;
        "(e|h)"           		0.9;
    }
}
