FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
pointSync false;

tol 1e-6;

// Patches to create

patches
(
    {
        name interface0;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (outlet);
    }
    {
        name interface1;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (rotorInlet);
    }
    {
        name interface2;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (rotorOutlet);
    }
    {
        name interface3;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (statorInlet);
    }
    {
        name interface4;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (statorOutlet);
    }
    {
        name interface5;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (Inlet);
    }
);


//************************************************************************ //
